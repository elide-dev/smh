amends "elide:project.pkl"

import "elide:Testing.pkl" as Testing
import "elide:Coverage.pkl" as Coverage

name = "smh"
version = "0.3.0" // x-release-please-version
description = "SubstrateVM Microbenchmark Harness"

sources {
  ["main"] = "src/main/java/**/*.java"
}

jvm {
  main = "dev.elide.smh.cli.Main"
  java {
    release = 25
    compiler {
      flags {
        "-processor"
        "io.micronaut.annotation.processing.BeanDefinitionInjectProcessor,picocli.codegen.aot.graalvm.processor.NativeImageConfigGeneratorProcessor"
      }
    }
  }
}

dependencies {
  maven {
    packages {
      "org.openjdk.jmh:jmh-core:1.37"
      "org.openjdk.jmh:jmh-generator-annprocess:1.37"
      "com.google.code.gson:gson:2.13.2"
      "org.graalvm.sdk:nativeimage:25.0.1"
      "io.micronaut.picocli:micronaut-picocli:5.9.0"
      "io.micronaut:micronaut-runtime:4.10.4"
      "io.micronaut:micronaut-inject-java:4.10.4"
      "info.picocli:picocli-codegen:4.7.7"
      // SourceGen's runtime dependencies are also needed by the processor classloader.
      "org.ow2.asm:asm:9.8"
      "org.ow2.asm:asm-commons:9.8"
      "org.ow2.asm:asm-util:9.8"
      "org.ow2.asm:asm-analysis:9.8"
      "io.jstach.rainbowgum:rainbowgum-core:0.17.0"
      "io.jstach.rainbowgum:rainbowgum-slf4j:0.17.0"
    }
    testPackages {
      "org.junit.jupiter:junit-jupiter:6.1.3"
      "org.junit.platform:junit-platform-console-standalone:6.1.3"
    }
  }
}

scripts {
  ["assemble"] = "python3 tools/build.py build"
  ["check"] = "python3 tools/test.py"
  ["native"] = "python3 tools/build.py native"
  ["smh"] = "java -cp 'build/smh.jar:build/lib/*' dev.elide.smh.cli.Main"
}

testing {
  reports { Testing.xmlReport() }
}

coverage {
  enabled = true
  scope = "tests"
  jvm {
    reports { Coverage.xmlReport(); Coverage.htmlReport() }
  }
}
